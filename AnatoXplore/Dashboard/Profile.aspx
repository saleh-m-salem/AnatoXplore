<%@ Page Title="My Dashboard | AnatoXplore" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Profile.aspx.cs" Inherits="AnatoXplore.Profile" %>
<asp:Content ID="ProfileContent" ContentPlaceHolderID="MainContent" runat="server">
<style>
.page-container{background:linear-gradient(135deg,rgba(241,248,255,.80),rgba(227,240,252,.76)),url('<%= ResolveUrl("~/Images/anatomy-background.png") %>') center/cover fixed}
.profile-dashboard-page{min-height:calc(100vh - 160px);padding:34px clamp(14px,3vw,42px) 52px;color:#183451;background:linear-gradient(135deg,rgba(241,248,255,.80),rgba(227,240,252,.76)),url('<%= ResolveUrl("~/Images/anatomy-background.png") %>') center/cover fixed}
.profile-dashboard-head{max-width:1320px;margin:0 auto 24px}.profile-dashboard-head h1{margin:0 0 6px;color:#12365b;font-size:32px}.profile-dashboard-head p{margin:0;color:#60768d}
.profile-dashboard-layout{max-width:1320px;margin:0 auto;display:grid;grid-template-columns:235px minmax(0,1fr);gap:24px;align-items:start}
.profile-sidebar,.dashboard-card{background:rgba(255,255,255,.96);border:1px solid #dce7f1;border-radius:17px;box-shadow:0 8px 24px rgba(18,54,91,.07)}.profile-sidebar{padding:12px;position:sticky;top:20px}.profile-sidebar nav{display:grid;gap:6px}.profile-nav-link{display:flex;align-items:center;gap:12px;padding:13px 14px;border-radius:10px;color:#294b6d;text-decoration:none;font-weight:650;transition:.18s}.profile-nav-link:hover{background:#edf6ff;color:#1265a6}.profile-nav-link.active{background:linear-gradient(100deg,#1688e8,#096bb9);color:white}.profile-nav-icon{width:22px;height:22px;display:inline-flex;align-items:center;justify-content:center;flex:0 0 22px}.profile-nav-icon svg{width:20px;height:20px;display:block;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.profile-main{min-width:0}.dashboard-panel{display:none}.dashboard-panel.active{display:block}.dashboard-panel>h2{margin:0 0 5px;color:#12365b;font-size:24px}.panel-intro{margin:0 0 18px;color:#718198;line-height:1.55}
.dashboard-grid{display:grid;grid-template-columns:minmax(250px,.9fr) minmax(320px,1.3fr);gap:18px;margin-bottom:18px}.dashboard-card{padding:22px}.dashboard-card h3{margin:0 0 14px;color:#12365b;font-size:19px}.dashboard-card p{color:#718198;line-height:1.6}
.profile-card{display:flex;flex-direction:column;align-items:center;text-align:center}.profile-avatar-frame{width:118px;height:118px;border-radius:50%;padding:6px;margin:3px 0 12px;background:linear-gradient(135deg,#1688e8,#0b5eaa);box-shadow:0 0 0 4px #e7f3ff}.profile-avatar-inner{width:100%;height:100%;border-radius:50%;overflow:hidden;background:#eaf4ff;display:flex;align-items:center;justify-content:center;color:#12365b;font-size:40px;font-weight:800}.profile-avatar-inner img{width:100%;height:100%;object-fit:cover}.profile-card h3{margin:0 0 6px}.profile-level-pill{border-radius:999px;padding:5px 11px;background:#eaf4ff;color:#1265a6;font-size:13px;font-weight:700}.profile-upload{width:100%;text-align:left;margin-top:18px}.profile-upload label,.profile-field label{display:block;font-size:13px;font-weight:700;color:#385570;margin:0 0 7px}.profile-upload input[type=file]{display:block;width:100%;font-size:12px;margin-bottom:8px}.profile-upload .profile-button{margin-top:4px}.profile-button,.dashboard-action{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:9px;padding:10px 15px;background:#1479c9;color:#fff!important;font-weight:700;text-decoration:none;cursor:pointer}.profile-button:hover,.dashboard-action:hover{background:#0c63a8}.profile-message{display:block;min-height:18px;margin-top:8px;color:#526b84;font-size:13px}
.profile-xp-total{font-size:34px;font-weight:800;color:#1479c9;margin:8px 0 2px}.profile-xp-caption{color:#718198;font-size:14px}.profile-progress-head{display:flex;justify-content:space-between;gap:12px;margin-top:25px;margin-bottom:8px;font-size:13px;color:#526b84}.profile-progress-track{height:12px;background:#e8f0f7;border-radius:999px;overflow:hidden}.profile-progress-fill{height:100%;border-radius:999px;background:linear-gradient(90deg,#1688e8,#41b4dc);transition:width .25s ease}.profile-progress-note{margin:9px 0 0;font-size:13px;color:#718198}
.profile-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.profile-field{min-width:0}.profile-field.wide{grid-column:1/-1}.profile-field input{width:100%;box-sizing:border-box;border:1px solid #d6e2ee;border-radius:9px;padding:11px 12px;color:#183451;font:inherit;background:#f9fcff}.profile-field input:focus{outline:0;border-color:#1688e8;box-shadow:0 0 0 3px #1688e81a}.profile-form-note{font-size:12px;color:#718198;margin:12px 0}.profile-form-actions{margin-top:8px}.profile-edit-message{display:block;margin-top:10px;color:#197044;font-size:13px}
.profile-frame-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.profile-frame-option{border:1px solid #e0e9f1;border-radius:13px;padding:14px;text-align:center;background:#fbfdff}.profile-frame-swatch{width:62px;height:62px;border-radius:50%;margin:0 auto 10px;padding:5px;background:linear-gradient(135deg,#1688e8,#0b5eaa)}.profile-frame-swatch-inner{width:100%;height:100%;border-radius:50%;background:#eaf4ff;display:flex;align-items:center;justify-content:center;color:#12365b;font-weight:800;font-size:20px}.profile-frame-option h4{font-size:14px;margin:0 0 4px;color:#183451}.profile-frame-status{display:block;min-height:18px;font-size:12px;color:#718198;margin-bottom:9px}.profile-frame-action{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:8px;padding:8px 10px;background:#1479c9;color:white!important;font-weight:700;text-decoration:none!important;cursor:pointer}.profile-frame-action:hover{text-decoration:none!important;background:#0c63a8}.profile-frame-action[disabled]{background:#e5edf4;color:#8394a5;cursor:not-allowed}
.frame-default-blue{background:linear-gradient(135deg,#1688e8,#0b5eaa)}.frame-teal-frost{background:linear-gradient(135deg,#54e0d0,#087e8b);box-shadow:0 0 0 4px #e1faf7}.frame-silver-frost{background:linear-gradient(135deg,#f4f7fb,#718198);box-shadow:0 0 0 4px #edf1f5}.frame-royal-blue{background:linear-gradient(135deg,#6554ed,#1838a8);box-shadow:0 0 0 4px #e8e7ff}.frame-rose-pink{background:linear-gradient(135deg,#ff84b4,#bd285f);box-shadow:0 0 0 4px #ffebf2}.frame-master-gold{background:linear-gradient(135deg,#ffe477,#b87905);box-shadow:0 0 0 4px #fff4cb}

.profile-table-wrap{overflow-x:auto}.profile-history-table{width:100%;border-collapse:collapse;min-width:650px}.profile-history-table th,.profile-history-table td{padding:12px 13px;border-bottom:1px solid #e8eef4;text-align:left;white-space:nowrap}.profile-history-table th{background:#f2f7fc;color:#385570;font-size:12px;text-transform:uppercase;letter-spacing:.04em}.profile-history-table td{color:#38516b;font-size:14px}.profile-score{font-weight:750;color:#16824b}.profile-xp-chip{display:inline-block;padding:4px 8px;border-radius:999px;background:#eaf4ff;color:#1265a6;font-weight:700;font-size:12px}.profile-empty{padding:22px;border-radius:12px;background:#f4f9ff;color:#647b91;text-align:center}.profile-chart-card{margin-bottom:18px}.profile-chart{width:100%;height:auto;display:block}.profile-chart .grid-line{stroke:#e1eaf3;stroke-width:1}.profile-chart .score-line{fill:none;stroke:#1688e8;stroke-width:4;stroke-linecap:round;stroke-linejoin:round}.profile-chart .score-point{fill:#fff;stroke:#0c72c4;stroke-width:3}.profile-chart text{font-family:"Segoe UI",Arial,sans-serif;fill:#718198;font-size:12px}.profile-chart .score-label{fill:#145d95;font-weight:700}
.profile-feedback-status{display:inline-block;padding:5px 9px;border:1px solid #cfe5fa;border-radius:999px;background:#eaf4ff;color:#1265a6;font-size:12px;font-weight:700}.profile-feedback-status[data-status="Resolved"],.profile-feedback-status[data-status="Reviewed"]{background:#dceeff;color:#075c9e;border-color:#b9daf5}.profile-feedback-status[data-status="Rejected"]{background:#e3eaf5;color:#355b82;border-color:#c8d7e9}.profile-feedback-actions{margin-top:15px}
@media(max-width:850px){.profile-dashboard-layout{grid-template-columns:1fr}.profile-sidebar{position:static}.profile-sidebar nav{grid-template-columns:repeat(3,minmax(0,1fr))}.profile-nav-link{justify-content:center;flex-direction:column;gap:5px;padding:10px 5px;font-size:12px;text-align:center}.dashboard-grid{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.profile-dashboard-page{padding:22px 12px 35px}.profile-dashboard-head h1{font-size:27px}.profile-sidebar nav{grid-template-columns:repeat(2,minmax(0,1fr))}.dashboard-grid,.profile-form-grid,.profile-field.wide{grid-column:auto}.profile-frame-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.dashboard-card{padding:17px}}
.profile-upload{margin-top:22px;padding:16px;background:linear-gradient(145deg,#f3f8fe,#fff);border:1px solid #dce8f4;border-radius:14px}.profile-upload-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.profile-upload-heading label{margin:0;color:#234969;font-size:14px}.profile-upload-heading p{margin:4px 0 0;color:#72859a;font-size:12px;line-height:1.45}.profile-upload-icon{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:11px;background:#e4f1fd;color:#1374bd;font-size:22px;font-weight:700}.profile-upload input[type=file]{display:block;box-sizing:border-box;width:100%;min-height:48px;margin:0;padding:7px;border:1px solid #d4e2ef;border-radius:10px;background:#fff;color:#526b84;font:inherit;font-size:13px}.profile-upload input[type=file]::file-selector-button{margin-right:10px;padding:8px 12px;border:0;border-radius:7px;background:#e6f1fb;color:#175889;font:inherit;font-weight:700;cursor:pointer;transition:background .18s ease}.profile-upload input[type=file]::file-selector-button:hover{background:#d7e9f8}.profile-upload .profile-button{width:100%;min-height:46px;margin-top:11px;border-radius:10px;box-shadow:0 5px 14px rgba(20,121,201,.16);transition:background .18s ease,transform .18s ease,box-shadow .18s ease}.profile-upload .profile-button:hover{transform:translateY(-1px);box-shadow:0 7px 18px rgba(20,121,201,.22)}.profile-upload .profile-message{margin-top:9px;color:#526b84;line-height:1.45}
</style>
<div class="profile-dashboard-page">
    <header class="profile-dashboard-head"><h1>My Dashboard</h1><p>Manage your account and keep track of your anatomy learning.</p></header>
    <div class="profile-dashboard-layout">
        <aside class="profile-sidebar" aria-label="Dashboard sections">
            <nav class="profile-nav">
                <a class="profile-nav-link active" href="#profile" data-dashboard-link="profile"><span class="profile-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c.6-3.3 3.2-5.2 7-5.2s6.4 1.9 7 5.2"/></svg></span><span>Profile</span></a>
                <a class="profile-nav-link" href="#quiz-history" data-dashboard-link="quiz-history"><span class="profile-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="3.5" width="16" height="17" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span><span>Quiz history</span></a>
                <a class="profile-nav-link" href="#feedback" data-dashboard-link="feedback"><span class="profile-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg></span><span>Feedback</span></a>
            </nav>
        </aside>
        <main class="profile-main">
            <section id="profile" class="dashboard-panel active" data-dashboard-panel="profile">
                <h2>Profile</h2><p class="panel-intro">Your account details, level, experience and profile frame.</p>
                <div class="dashboard-grid">
                    <section class="dashboard-card profile-card" aria-label="Profile information">
                        <div id="avatarFrame" runat="server" class="profile-avatar-frame"><div class="profile-avatar-inner"><asp:Image ID="imgProfilePhoto" runat="server" Visible="false" AlternateText="Your profile photo" /><asp:Label ID="lblProfileInitial" runat="server" /></div></div>
                        <h3><asp:Label ID="lblProfileName" runat="server" /></h3>
                        <span class="profile-level-pill"><asp:Label ID="lblProfileLevel" runat="server" /></span>
                        <div class="profile-upload"><div class="profile-upload-heading"><div><label for="profilePhotoUpload">Profile photo</label><p>Choose a JPG or PNG image, up to 5 MB.</p></div></div><asp:FileUpload ID="profilePhotoUpload" runat="server" ClientIDMode="Static" /><asp:Button ID="btnUploadPhoto" runat="server" Text="Upload photo" CssClass="profile-button" OnClick="btnUploadPhoto_Click" CausesValidation="false" /><asp:Label ID="lblProfileMessage" runat="server" CssClass="profile-message" /></div>
                    </section>
                    <section class="dashboard-card" aria-label="Experience progress">
                        <h3>Experience and level</h3><div class="profile-xp-total"><asp:Label ID="lblTotalXP" runat="server" /> XP</div><div class="profile-xp-caption">Total experience from your quiz attempts</div>
                        <div class="profile-progress-head"><span><asp:Label ID="lblProgressLevel" runat="server" /></span><span><asp:Label ID="lblNextLevel" runat="server" /></span></div>
                        <div class="profile-progress-track" role="progressbar" aria-label="Progress to next level" aria-valuemin="0" aria-valuemax="100"><div id="progressFill" runat="server" class="profile-progress-fill"></div></div><p class="profile-progress-note"><asp:Label ID="lblProgressNote" runat="server" /></p>
                    </section>
                </div>
                <section class="dashboard-card" style="margin-bottom:18px"><h3>Edit profile</h3><p class="panel-intro">Update your name or email. Leave the password fields blank to keep your current password.</p>
                    <div class="profile-form-grid">
                        <div class="profile-field"><label for="txtEditFullName">Full name</label><asp:TextBox ID="txtEditFullName" runat="server" ClientIDMode="Static" MaxLength="100" /></div>
                        <div class="profile-field"><label for="txtEditEmail">Email address</label><asp:TextBox ID="txtEditEmail" runat="server" ClientIDMode="Static" TextMode="Email" MaxLength="150" /></div>
                        <div class="profile-field"><label for="txtNewPassword">New password</label><asp:TextBox ID="txtNewPassword" runat="server" ClientIDMode="Static" TextMode="Password" MaxLength="128" autocomplete="new-password" /></div>
                        <div class="profile-field"><label for="txtConfirmPassword">Confirm new password</label><asp:TextBox ID="txtConfirmPassword" runat="server" ClientIDMode="Static" TextMode="Password" MaxLength="128" autocomplete="new-password" /></div>
                    </div><p class="profile-form-note">A new password must be at least 8 characters.</p>
                    <div class="profile-form-actions"><asp:Button ID="btnSaveProfile" runat="server" Text="Save profile" CssClass="profile-button" OnClick="btnSaveProfile_Click" CausesValidation="false" /><asp:Label ID="lblEditProfileMessage" runat="server" CssClass="profile-edit-message" /></div>
                </section>
                <section class="dashboard-card"><h3>Profile frames</h3><p class="panel-intro">Earn new frames by levelling up. Default Blue is active by default; select any frame you have unlocked.</p>
                    <asp:Repeater ID="rptFrames" runat="server" OnItemCommand="rptFrames_ItemCommand"><HeaderTemplate><div class="profile-frame-grid"></HeaderTemplate><ItemTemplate><article class="profile-frame-option"><div class='profile-frame-swatch <%# GetFrameCss(Eval("FrameKey")) %>'><div class="profile-frame-swatch-inner">AX</div></div><h4><%#: Eval("FrameName") %></h4><asp:Label ID="lblFrameStatus" runat="server" CssClass="profile-frame-status" Text='<%# GetFrameStatus(Eval("IsUnlocked"), Eval("IsEquipped"), Eval("RequiredLevel")) %>' /><asp:LinkButton ID="btnEquipFrame" runat="server" CssClass="profile-frame-action" CommandName="EquipFrame" CommandArgument='<%# Eval("FrameID") %>' Enabled='<%# IsFrameUnlocked(Eval("IsUnlocked")) %>' Text='<%# GetFrameAction(Eval("IsUnlocked"), Eval("IsEquipped")) %>' CausesValidation="false" /></article></ItemTemplate><FooterTemplate></div></FooterTemplate></asp:Repeater>
                </section>
            </section>
            <section id="quiz-history" class="dashboard-panel" data-dashboard-panel="quiz-history"><h2>Quiz history</h2><p class="panel-intro">Review your scores, answer speed and XP from recent attempts.</p><section class="dashboard-card profile-chart-card"><h3>Score progress</h3><asp:Panel ID="pnlNoQuizChart" runat="server" CssClass="profile-empty" Visible="false">Complete a quiz to see your progress chart.</asp:Panel><asp:Literal ID="litQuizChart" runat="server" /></section><section class="dashboard-card"><h3>Recent attempts</h3><asp:Panel ID="pnlNoQuizHistory" runat="server" CssClass="profile-empty" Visible="false">No quiz attempts yet. Your completed quizzes will appear here.</asp:Panel><asp:Panel ID="pnlQuizHistoryTable" runat="server" CssClass="profile-table-wrap"><table class="profile-history-table"><thead><tr><th>Quiz</th><th>Marks</th><th>Score</th><th>Time taken</th><th>Speed bonus</th><th>XP gained</th><th>Date</th></tr></thead><tbody><asp:Repeater ID="rptQuizHistory" runat="server"><ItemTemplate><tr><td><%#: Eval("SystemName") %></td><td><%#: Eval("Score") %> / <%#: Eval("TotalQuestions") %></td><td class="profile-score"><%#: Eval("PercentScore", "{0:0.#}%") %></td><td><%#: Eval("DurationSeconds") == DBNull.Value ? "Not recorded" : String.Format("{0:mm\\:ss}", TimeSpan.FromSeconds(Convert.ToInt32(Eval("DurationSeconds")))) %></td><td><%#: Eval("SpeedBonusXP") %> XP</td><td><span class="profile-xp-chip">+<%#: Eval("XPgained") %> XP</span></td><td><%#: Eval("AttemptDate", "{0:dd MMM yyyy}") %></td></tr></ItemTemplate></asp:Repeater></tbody></table></asp:Panel></section></section>
                        <section id="feedback" class="dashboard-panel" data-dashboard-panel="feedback">
                <h2>Feedback</h2><p class="panel-intro">See feedback you have sent and whether it has been reviewed.</p>
                <asp:Panel ID="pnlNoFeedback" runat="server" CssClass="profile-empty" Visible="false">You have not submitted feedback yet.</asp:Panel>
                <asp:Panel ID="pnlFeedbackCard" runat="server" CssClass="dashboard-card">
                    <div class="profile-table-wrap"><table class="profile-history-table"><thead><tr><th>Subject</th><th>Type</th><th>Status</th><th>Submitted</th></tr></thead><tbody><asp:Repeater ID="rptFeedback" runat="server"><ItemTemplate><tr><td><%#: Eval("Subject") %></td><td><%#: Eval("FeedbackType") %></td><td><span class="profile-feedback-status" data-status='<%#: Eval("Status") %>'><%#: Eval("Status") %></span></td><td><%#: Eval("SubmittedAt", "{0:dd MMM yyyy}") %></td></tr></ItemTemplate></asp:Repeater></tbody></table></div>
                </asp:Panel>
                <div class="profile-feedback-actions"><a class="dashboard-action" href="<%= ResolveUrl("~/Feedback/Feedback.aspx") %>">Send feedback</a></div>
            </section>
</main>
    </div>
</div>
<script>
(function(){
 var links=document.querySelectorAll('[data-dashboard-link]');
 var panels=document.querySelectorAll('[data-dashboard-panel]');
 function activate(name){var found=false;panels.forEach(function(p){var on=p.getAttribute('data-dashboard-panel')===name;p.classList.toggle('active',on);if(on)found=true;});if(!found)name='profile';links.forEach(function(a){var on=a.getAttribute('data-dashboard-link')===name;a.classList.toggle('active',on);if(on)a.setAttribute('aria-current','page');else a.removeAttribute('aria-current');});}
 links.forEach(function(a){a.addEventListener('click',function(){activate(a.getAttribute('data-dashboard-link'));});});
 var initial=(location.hash||'').replace('#','');activate(initial||'profile');
 window.addEventListener('hashchange',function(){activate((location.hash||'').replace('#','')||'profile');});
})();
</script>
</asp:Content>
