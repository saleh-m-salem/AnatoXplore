<%@ Page Title="Admin Dashboard | AnatoXplore" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="AdminDashboard.aspx.cs" Inherits="AnatoXplore.AdminDashboard" %>
<asp:Content ID="AdminHead" ContentPlaceHolderID="HeadContent" runat="server">
<style>
.admin-shell{max-width:1600px;margin:36px auto;padding:0 28px 48px;color:#12365b}.admin-head{margin-bottom:24px}.admin-head h1{display:flex;align-items:center;gap:14px;margin:0;color:#12365b;font-size:38px}.admin-head p{margin:8px 0 0;color:#617b98;font-size:18px}.admin-badge{display:inline-flex;align-items:center;padding:7px 14px;border-radius:999px;background:#e5f0fb;color:#155b96;font-size:14px;font-weight:800}.admin-layout{display:grid;grid-template-columns:280px minmax(0,1fr);gap:26px;align-items:start}.admin-side{display:flex;flex-direction:column;gap:8px;padding:18px;background:#0d2f50;border-radius:20px;box-shadow:0 8px 24px rgba(17,50,82,.12)}.admin-nav{display:block;padding:15px 16px;border-radius:12px;color:#e8f3ff!important;font-size:16px;font-weight:700;line-height:1.35}.admin-nav:hover,.admin-nav:focus{background:#17466f;color:#fff!important}.admin-nav.active{background:#e7f1fb;color:#123f68!important}.admin-content{min-width:0}.admin-content h2{margin:0 0 18px;color:#12365b;font-size:23px}.admin-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:20px}.admin-stat,.admin-panel{background:#fff;border:1px solid #d7e5f3;border-radius:18px;box-shadow:0 8px 24px rgba(25,60,96,.06)}.admin-stat{padding:20px 22px}.admin-stat span{display:block;color:#607b98;font-size:15px}.admin-stat strong{display:block;margin-top:8px;color:#1673bd;font-size:32px}.admin-overview-grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(280px,.9fr);gap:20px}.admin-panel{padding:22px;margin-bottom:18px}.admin-table-wrap{width:100%;overflow-x:auto}.admin-table{width:100%;border-collapse:collapse;color:#173b60;font-size:14px}.admin-table th{padding:12px 14px;background:#edf4fa;color:#24496e;text-align:left;font-weight:800;white-space:nowrap}.admin-table td{padding:13px 14px;border-bottom:1px solid #e2ebf4;vertical-align:top}.admin-table tbody tr:hover{background:#f8fbfe}.admin-toolbar{display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin:0 0 18px}.admin-input,.admin-select,.admin-editor input[type=text],.admin-editor input[type=number],.admin-editor textarea,.admin-editor select{min-height:44px;padding:10px 13px;border:1px solid #c8d9eb;border-radius:10px;background:#fff;color:#173b60;font:inherit}.admin-input{min-width:250px}.admin-editor textarea{width:100%;min-height:100px}.admin-editor label{display:flex;flex-direction:column;gap:7px;color:#58728d;font-size:14px;font-weight:700}.admin-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.admin-form .wide,.admin-form label.wide{grid-column:1/-1}.admin-editor h3{margin:0 0 16px;color:#12365b;font-size:20px}.admin-btn{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:9px 15px;border:1px solid #1976bc;border-radius:10px;background:#1976bc;color:#fff!important;font:inherit;font-weight:700;text-decoration:none;cursor:pointer}.admin-btn:hover,.admin-btn:focus{background:#125f9c;border-color:#125f9c}.admin-btn.secondary{border-color:#d9e7f4;background:#e8f1fa;color:#17466f!important}.admin-btn.secondary:hover,.admin-btn.secondary:focus{background:#d9e9f7}.admin-btn.danger{border-color:#b84b55;background:#b84b55;color:#fff!important}.admin-actions{display:flex;align-items:center;gap:8px}.admin-count-list>div{display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid #e4edf5;color:#56718d}.admin-count-list strong{color:#163b61}.admin-message{display:block;margin:0 0 18px;padding:13px 17px;border:1px solid #cfe1f1;border-radius:12px;font-weight:700}.admin-message:empty{display:none}.status-badge{display:inline-block;padding:5px 10px;border-radius:999px;font-size:12px;font-weight:800}.admin-note{color:#69819a}.grid-pager td{padding:14px}.grid-pager a,.grid-pager span{display:inline-block;margin-right:6px;padding:7px 11px;border-radius:8px;background:#e8f1fa;color:#17466f;text-decoration:none}.admin-search-box{flex:0 1 360px}@media(max-width:1050px){.admin-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.admin-overview-grid{grid-template-columns:1fr}}@media(max-width:650px){.admin-shell{margin:22px auto;padding:0 14px 32px}.admin-head h1{font-size:30px}.admin-layout{grid-template-columns:1fr;gap:16px}.admin-side{grid-template-columns:repeat(2,minmax(0,1fr));padding:12px}.admin-nav{padding:11px;font-size:14px}.admin-stats{gap:10px}.admin-stat{padding:15px}.admin-stat strong{font-size:26px}.admin-panel{padding:16px}.admin-form{grid-template-columns:1fr}.admin-form .wide,.admin-form label.wide{grid-column:auto}.admin-input{min-width:0;width:100%}}
.admin-side{position:sticky;top:20px;z-index:2}.admin-nav,.admin-nav:link,.admin-nav:visited,.admin-nav:hover,.admin-nav:focus{text-decoration:none!important}.status-pending{background:#e8f2fc;color:#174a7c}.status-reviewed{background:#d7e9fa;color:#164c7c}.status-admin{background:#c7def4;color:#123f6c}.admin-message{background:#e8f2fc;color:#174a7c;opacity:1;transition:opacity .45s ease,transform .45s ease}.admin-message.is-hidden{opacity:0;transform:translateY(-5px);pointer-events:none}.admin-message.error{background:#edf3f9;color:#8b3540}.admin-editor{padding:18px;margin:16px 0;background:#f7faff;border:1px solid #dce7f2;border-radius:12px}.admin-search-box{position:relative;min-width:260px}.admin-search-box .admin-input{width:100%}.admin-user-suggestions{display:none;position:absolute;z-index:20;top:calc(100% + 5px);left:0;right:0;max-height:280px;overflow:auto;background:#fff;border:1px solid #cbd8e6;border-radius:9px;box-shadow:0 8px 22px rgba(13,51,91,.16)}.admin-user-suggestion{display:block;width:100%;padding:10px 12px;border:0;border-bottom:1px solid #e6eef6;background:#fff;text-align:left;color:#183153;cursor:pointer}.admin-user-suggestion:hover,.admin-user-suggestion:focus{background:#e8f2fc;outline:0}.admin-user-suggestion strong,.admin-user-suggestion span{display:block}.admin-user-suggestion span{margin-top:2px;color:#637a94;font-size:12px}.admin-content-grid td{max-width:260px;overflow-wrap:anywhere}.admin-content-grid .admin-actions{flex-wrap:wrap}.admin-content-grid .admin-btn{white-space:nowrap}.admin-filter{display:flex;align-items:center;gap:7px;color:#526b86;font-size:12px;font-weight:700}.admin-filter .admin-select{min-width:210px}.admin-nav{position:relative}@media(max-width:900px){.admin-side{position:relative;top:auto;display:grid;grid-template-columns:repeat(2,1fr)}}
.admin-cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:22px}.admin-columns{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(300px,.9fr);gap:20px;align-items:start}.admin-layout{min-height:760px}.admin-content{min-height:760px}.admin-side{position:fixed;top:28vh;left:max(28px,calc((100vw - 1600px)/2 + 28px));width:280px;max-height:68vh;overflow-y:auto;align-self:start}.admin-panel{min-height:300px}.admin-content > section.admin-panel{min-height:700px}@media(max-width:1050px){.admin-cards{grid-template-columns:repeat(2,minmax(0,1fr))}.admin-columns{grid-template-columns:1fr}}@media(max-width:900px){.admin-layout{min-height:0}.admin-content{min-height:0}.admin-side{position:relative;top:auto;left:auto;width:auto;max-height:none;overflow:visible;display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.admin-content > section.admin-panel{min-height:0}}@media(max-width:650px){.admin-cards{grid-template-columns:1fr 1fr}.admin-columns{grid-template-columns:1fr}}
.admin-shell{width:100%}.admin-layout{width:100%;grid-template-columns:280px minmax(0,1fr)}.admin-content{width:100%;min-width:0}.admin-cards,.admin-columns{width:100%}.admin-side{max-height:none;overflow:visible;top:28vh;padding:12px;gap:5px}.admin-nav{padding:11px 14px}.admin-content>section.admin-panel{width:100%;box-sizing:border-box}@media(max-width:900px){.admin-shell{width:100%}.admin-layout{width:100%;grid-template-columns:1fr}.admin-side{position:relative;top:auto;left:auto;width:100%;max-height:none;overflow:visible;display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.admin-cards{grid-template-columns:repeat(2,minmax(0,1fr))}.admin-content>section.admin-panel{min-height:0}}
.admin-content{grid-column:2}.admin-side{top:calc(28vh + 60px);max-height:none;overflow:visible}.admin-cards{grid-template-columns:repeat(4,minmax(0,1fr));width:100%}.admin-columns{width:100%}@media(max-width:900px){.admin-content{grid-column:1}.admin-side{top:auto;left:auto;width:100%;max-height:none;overflow:visible;position:relative}.admin-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
.admin-side{position:static!important;top:auto!important;left:auto!important;width:auto;max-height:none;overflow:visible}html body{background-color:#eaf4ff;background-image:url('<%= ResolveUrl("~/Images/anatomy-background.png") %>');background-repeat:no-repeat;background-position:center top;background-size:cover;background-attachment:fixed}
 .admin-user-editor{margin-top:18px;padding:24px;background:linear-gradient(135deg,#f7fbff 0%,#fff 72%);border:1px solid #d5e4f3;border-radius:18px;box-shadow:0 10px 28px rgba(18,54,91,.08)}.admin-user-editor-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:22px;padding-bottom:16px;border-bottom:1px solid #e1ebf5}.admin-user-editor-head h2{margin:0;color:#12365b;font-size:23px}.admin-user-editor-head p{margin:6px 0 0;color:#66809b;font-size:14px}.admin-edit-badge{flex:0 0 auto;padding:7px 12px;border:1px solid #d4e5f5;border-radius:999px;background:#edf5fc;color:#28618f;font-size:12px;font-weight:800}.admin-user-editor .admin-form{column-gap:18px;row-gap:16px}.admin-user-editor .admin-form>label{min-width:0;color:#365a7c;font-size:14px}.admin-user-editor input[type=text],.admin-user-editor input[type=email],.admin-user-editor select{width:100%;min-width:0;min-height:48px;box-sizing:border-box;padding:11px 14px;border:1px solid #c8d9eb;border-radius:10px;background:#fff;color:#173b60;font:inherit;transition:border-color .18s ease,box-shadow .18s ease}.admin-user-editor input:focus,.admin-user-editor select:focus{outline:0;border-color:#2785c9;box-shadow:0 0 0 3px rgba(39,133,201,.14)}.admin-user-editor .admin-form>label:nth-of-type(3){max-width:360px}.admin-user-editor .admin-actions{justify-content:flex-end;margin-top:4px;padding-top:16px;border-top:1px solid #e1ebf5}.admin-user-editor .admin-actions .admin-btn{min-width:120px;min-height:44px}.admin-user-editor .admin-actions .secondary{border-color:#cfdfef;background:#f0f6fc}@media(max-width:650px){.admin-user-editor{padding:18px}.admin-user-editor-head{align-items:flex-start}.admin-edit-badge{display:none}.admin-user-editor .admin-form>label:nth-of-type(3){max-width:none}.admin-user-editor .admin-actions{justify-content:stretch}.admin-user-editor .admin-actions .admin-btn{flex:1;min-width:0}}
 </style>
</asp:Content>
<asp:Content ID="AdminBody" ContentPlaceHolderID="MainContent" runat="server">
<div class="admin-shell">
 <div class="admin-head"><div><h1>Admin Dashboard <span class="admin-badge">ADMIN</span></h1><p>Manage learning content, accounts and community activity.</p></div></div>
 <asp:Label ID="lblMessage" runat="server" CssClass="admin-message" Visible="false" />
 <div class="admin-layout">
  <aside class="admin-side">
   <asp:LinkButton ID="navOverview" runat="server" CssClass="admin-nav active" CommandArgument="Overview" OnClick="Navigate_Click">Overview</asp:LinkButton>
   <asp:LinkButton ID="navUsers" runat="server" CssClass="admin-nav" CommandArgument="Users" OnClick="Navigate_Click">Manage users</asp:LinkButton>
   <asp:LinkButton ID="navContent" runat="server" CssClass="admin-nav" CommandArgument="Content" OnClick="Navigate_Click">Lesson content</asp:LinkButton>
   <asp:LinkButton ID="navDiscussions" runat="server" CssClass="admin-nav" CommandArgument="Discussions" OnClick="Navigate_Click">Discussions</asp:LinkButton>
   <asp:LinkButton ID="navFeedback" runat="server" CssClass="admin-nav" CommandArgument="Feedback" OnClick="Navigate_Click">Reports &amp; Feedback</asp:LinkButton>
   <asp:LinkButton ID="navResults" runat="server" CssClass="admin-nav" CommandArgument="Results" OnClick="Navigate_Click">Student learning data</asp:LinkButton>
  </aside>
  <main class="admin-content">
   <asp:MultiView ID="mvAdmin" runat="server" ActiveViewIndex="0">
    <asp:View ID="vwOverview" runat="server">
     <div class="admin-cards">
      <div class="admin-stat"><span>Registered students</span><strong><asp:Literal ID="litStudents" runat="server" /></strong></div>
      <div class="admin-stat"><span>Anatomy systems</span><strong><asp:Literal ID="litSystems" runat="server" /></strong></div>
      <div class="admin-stat"><span>Quiz questions</span><strong><asp:Literal ID="litQuestions" runat="server" /></strong></div>
      <div class="admin-stat"><span>Discussion posts</span><strong><asp:Literal ID="litDiscussions" runat="server" /></strong></div>
     </div>
     <div class="admin-columns">
      <section class="admin-panel"><h2>Recent platform activity</h2><div class="admin-table-wrap"><asp:GridView ID="gvActivity" runat="server" AutoGenerateColumns="false" CssClass="admin-table" GridLines="None" EmptyDataText="No recent platform activity."><Columns><asp:BoundField DataField="ActionName" HeaderText="Activity"/><asp:BoundField DataField="Details" HeaderText="Details"/><asp:BoundField DataField="CreatedAt" HeaderText="Date" DataFormatString="{0:g}"/><asp:BoundField DataField="ActorName" HeaderText="User"/></Columns></asp:GridView></div></section>
      <div><section class="admin-panel"><h2>Content overview</h2><div class="admin-count-list"><div><span>Topics / systems</span><strong><asp:Literal ID="litContentSystems" runat="server" /></strong></div><div><span>Quiz questions</span><strong><asp:Literal ID="litContentQuestions" runat="server" /></strong></div><div><span>Videos</span><strong><asp:Literal ID="litVideos" runat="server" /></strong></div><div><span>Flashcards</span><strong><asp:Literal ID="litFlashcards" runat="server" /></strong></div></div></section>
       <section class="admin-panel"><h2>Reports &amp; Feedback</h2><asp:Literal ID="litFeedbackSummary" runat="server" /></section></div>
     </div>
    </asp:View>
    <asp:View ID="vwUsers" runat="server">
      <section class="admin-panel"><h2>Manage users</h2><div class="admin-toolbar"><div class="admin-search-box"><asp:TextBox ID="txtUserSearch" runat="server" CssClass="admin-input" placeholder="Search name or email" autocomplete="off" oninput="showUserSuggestions(this.value)" onfocus="showUserSuggestions(this.value)" onkeydown="handleUserSuggestionKeys(event)"/><div id="userSearchSuggestions" class="admin-user-suggestions" role="listbox"></div></div><asp:Button ID="btnUserSearch" runat="server" Text="Search" CssClass="admin-btn" OnClick="UserSearch_Click"/><asp:Button ID="btnUserClear" runat="server" Text="Clear" CssClass="admin-btn secondary" OnClick="UserClear_Click"/></div><div id="adminUserSuggestionSource" style="display:none"><asp:Repeater ID="rptUserSuggestions" runat="server"><ItemTemplate><span data-name='<%#: Eval("FullName") %>' data-email='<%#: Eval("Email") %>'></span></ItemTemplate></asp:Repeater></div>
      <div class="admin-table-wrap"><asp:GridView ID="gvUsers" runat="server" AutoGenerateColumns="false" CssClass="admin-table" GridLines="None" AllowPaging="true" PageSize="10" DataKeyNames="UserID" OnPageIndexChanging="Users_PageIndexChanging" OnRowCommand="Users_RowCommand"><Columns><asp:BoundField DataField="FullName" HeaderText="Name"/><asp:BoundField DataField="Email" HeaderText="Email"/><asp:BoundField DataField="Role" HeaderText="Access"/><asp:BoundField DataField="CreatedAt" HeaderText="Joined" DataFormatString="{0:d}"/><asp:TemplateField HeaderText="Action"><ItemTemplate><asp:LinkButton runat="server" CssClass="admin-btn secondary" CommandName="EditUser" CommandArgument='<%# Eval("UserID") %>' Text="Edit" CausesValidation="false"/></ItemTemplate></asp:TemplateField></Columns><PagerStyle CssClass="grid-pager"/></asp:GridView></div>
      <asp:Panel ID="pnlUserEdit" runat="server" Visible="false" CssClass="admin-editor admin-user-editor"><div class="admin-user-editor-head"><div><h2>Edit account</h2><p>Update the account details and access level.</p></div><span class="admin-edit-badge">Account settings</span></div><div class="admin-form"><asp:HiddenField ID="hfUserID" runat="server"/><label>Full name<asp:TextBox ID="txtEditName" runat="server" MaxLength="100"/></label><label>Email<asp:TextBox ID="txtEditEmail" runat="server" MaxLength="150" TextMode="Email"/></label><label>Role<asp:DropDownList ID="ddlEditRole" runat="server"><asp:ListItem>Student</asp:ListItem><asp:ListItem>Admin</asp:ListItem></asp:DropDownList></label><div class="wide admin-actions"><asp:Button ID="btnSaveUser" runat="server" Text="Save user" CssClass="admin-btn" OnClick="SaveUser_Click"/><asp:Button ID="btnCancelUser" runat="server" Text="Cancel" CssClass="admin-btn secondary" CausesValidation="false" OnClick="CancelUser_Click"/></div></div></asp:Panel>
     </section>
    </asp:View>
    <asp:View ID="vwContent" runat="server">
      <section class="admin-panel"><h2>Manage lesson content</h2><div class="admin-toolbar"><label class="admin-filter">Content type <asp:DropDownList ID="ddlContentType" runat="server" CssClass="admin-select" AutoPostBack="true" OnSelectedIndexChanged="ContentType_Changed"><asp:ListItem Value="Flashcards">Flashcards</asp:ListItem><asp:ListItem Value="Questions">Quiz questions</asp:ListItem><asp:ListItem Value="Videos">Videos</asp:ListItem></asp:DropDownList></label><label class="admin-filter">Body system <asp:DropDownList ID="ddlContentSystem" runat="server" CssClass="admin-select"/></label><asp:Button ID="btnContentFilter" runat="server" Text="Show items" CssClass="admin-btn" OnClick="ContentFilter_Click"/></div>
       <asp:Panel ID="pnlContentForm" runat="server" CssClass="admin-editor"><h2><asp:Literal ID="litContentFormTitle" runat="server" Text="Add flashcard"/></h2><asp:HiddenField ID="hfContentID" runat="server"/><div class="admin-form">
       <label class="wide">Question / title<asp:TextBox ID="txtContentTitle" runat="server" MaxLength="1000"/></label>
       <asp:Panel ID="pnlFlashcardFields" runat="server" CssClass="wide"><label>Answer<asp:TextBox ID="txtFlashAnswer" runat="server" TextMode="MultiLine" Rows="3"/></label><label>Display order<asp:TextBox ID="txtFlashOrder" runat="server" Text="1" TextMode="Number"/></label></asp:Panel>
        <asp:Panel ID="pnlQuestionFields" runat="server" CssClass="wide" Visible="false"><asp:HiddenField ID="hfQuestionExplanation" runat="server"/><div class="admin-form"><label>Option A<asp:TextBox ID="txtOptionA" runat="server" MaxLength="300"/></label><label>Option B<asp:TextBox ID="txtOptionB" runat="server" MaxLength="300"/></label><label>Option C<asp:TextBox ID="txtOptionC" runat="server" MaxLength="300"/></label><label>Option D<asp:TextBox ID="txtOptionD" runat="server" MaxLength="300"/></label><label>Correct answer<asp:DropDownList ID="ddlCorrectAnswer" runat="server"><asp:ListItem>A</asp:ListItem><asp:ListItem>B</asp:ListItem><asp:ListItem>C</asp:ListItem><asp:ListItem>D</asp:ListItem></asp:DropDownList></label></div></asp:Panel>
       <asp:Panel ID="pnlVideoFields" runat="server" CssClass="wide" Visible="false"><label>Video URL (HTTPS)<asp:TextBox ID="txtVideoUrl" runat="server" MaxLength="500"/></label><label>Description<asp:TextBox ID="txtVideoDescription" runat="server" MaxLength="500" TextMode="MultiLine" Rows="2"/></label></asp:Panel>
       <div class="wide admin-actions"><asp:Button ID="btnSaveContent" runat="server" Text="Save content" CssClass="admin-btn" OnClick="SaveContent_Click"/><asp:Button ID="btnCancelContent" runat="server" Text="Clear form" CssClass="admin-btn secondary" OnClick="CancelContent_Click" CausesValidation="false"/></div>
      </div></asp:Panel>
       <div class="admin-table-wrap"><asp:GridView ID="gvContent" runat="server" AutoGenerateColumns="true" CssClass="admin-table admin-content-grid" GridLines="None" AllowPaging="true" PageSize="10" OnPageIndexChanging="Content_PageIndexChanging" OnRowCommand="Content_RowCommand" OnRowCreated="Content_RowCreated" OnRowDataBound="Content_RowDataBound"><Columns><asp:TemplateField HeaderText="Actions"><ItemTemplate><div class="admin-actions"><asp:LinkButton runat="server" CssClass="admin-btn secondary" CommandName="EditContent" CommandArgument='<%# Eval("ItemID") %>' Text="Edit" CausesValidation="false"/><asp:LinkButton ID="btnArchiveContent" runat="server" CssClass="admin-btn danger" CommandName="DeleteContent" CommandArgument='<%# Eval("ItemID") %>' Text="Delete" CausesValidation="false" OnClientClick="return confirm('Delete or archive this content item? Continue?');"/><asp:LinkButton ID="btnRestoreContent" runat="server" CssClass="admin-btn" CommandName="RestoreContent" CommandArgument='<%# Eval("ItemID") %>' Text="Restore" CausesValidation="false" Visible="false"/></div></ItemTemplate></asp:TemplateField></Columns><PagerStyle CssClass="grid-pager"/></asp:GridView></div>
     </section>
    </asp:View>
    <asp:View ID="vwDiscussions" runat="server"><section class="admin-panel"><h2>Discussion moderation</h2><div class="admin-toolbar"><asp:TextBox ID="txtDiscussionSearch" runat="server" CssClass="admin-input" placeholder="Search title, post or author"/><asp:Button ID="btnDiscussionSearch" runat="server" Text="Search" CssClass="admin-btn" OnClick="DiscussionSearch_Click"/><asp:Button ID="btnDiscussionClear" runat="server" Text="Clear" CssClass="admin-btn secondary" OnClick="DiscussionClear_Click"/></div><div class="admin-table-wrap"><asp:GridView ID="gvDiscussions" runat="server" AutoGenerateColumns="false" CssClass="admin-table" GridLines="None" AllowPaging="true" PageSize="10" OnPageIndexChanging="Discussions_PageIndexChanging" OnRowCommand="Discussions_RowCommand"><Columns><asp:BoundField DataField="DiscussionID" HeaderText="#"/><asp:BoundField DataField="Title" HeaderText="Title"/><asp:BoundField DataField="Author" HeaderText="Author"/><asp:BoundField DataField="PostContent" HeaderText="Post"/><asp:BoundField DataField="CreatedAt" HeaderText="Date" DataFormatString="{0:g}"/><asp:TemplateField HeaderText="Action"><ItemTemplate><asp:LinkButton runat="server" CssClass="admin-btn danger" Text="Delete" CommandName="DeletePost" CommandArgument='<%# Eval("DiscussionID") %>' CausesValidation="false" OnClientClick="return confirm('Delete this post and its replies? This cannot be undone.');"/></ItemTemplate></asp:TemplateField></Columns><PagerStyle CssClass="grid-pager"/></asp:GridView></div></section></asp:View>
