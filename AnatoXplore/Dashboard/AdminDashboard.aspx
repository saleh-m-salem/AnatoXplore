</div>
<script type="text/javascript">
(function () {
    var searchBox = document.getElementById('<%= txtUserSearch.ClientID %>');
    var suggestionBox = document.getElementById('userSearchSuggestions');
    var source = document.querySelectorAll('#adminUserSuggestionSource [data-name]');
    if (!searchBox || !suggestionBox) return;
    window.showUserSuggestions = function (value) {
        var query = (value || '').trim().toLowerCase();
        suggestionBox.innerHTML = '';
        if (!query) { suggestionBox.style.display = 'none'; return; }
        var shown = 0;
        for (var i = 0; i < source.length && shown < 8; i++) {
            var name = source[i].getAttribute('data-name') || '';
            var email = source[i].getAttribute('data-email') || '';
            if (name.toLowerCase().indexOf(query) < 0 && email.toLowerCase().indexOf(query) < 0) continue;
            var option = document.createElement('button');
            option.type = 'button'; option.className = 'admin-user-suggestion'; option.setAttribute('role', 'option');
            var nameLine = document.createElement('strong'); nameLine.textContent = name;
            var emailLine = document.createElement('span'); emailLine.textContent = email;
            option.appendChild(nameLine); option.appendChild(emailLine);
            option.addEventListener('mousedown', function (event) {
                event.preventDefault(); searchBox.value = this.querySelector('strong').textContent;
                suggestionBox.style.display = 'none';
                document.getElementById('<%= btnUserSearch.ClientID %>').click();
            });
            suggestionBox.appendChild(option); shown++;
        }
        suggestionBox.style.display = shown ? 'block' : 'none';
    };
    window.handleUserSuggestionKeys = function (event) { if (event.key === 'Escape') suggestionBox.style.display = 'none'; };
    document.addEventListener('click', function (event) { if (!event.target.closest('.admin-search-box')) suggestionBox.style.display = 'none'; });
    var message = document.getElementById('<%= lblMessage.ClientID %>');
    if (message && message.getAttribute('data-autohide') === 'true') {
        window.setTimeout(function () { message.classList.add('is-hidden'); }, 4500);
    }
}());
</script>
</asp:Content>
